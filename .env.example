# ─────────────────────────────────────────────────────────────────────────────
# Bayaan — environment. Copy to .env and fill in. Nothing here is a real secret.
# ─────────────────────────────────────────────────────────────────────────────

# --- core -------------------------------------------------------------------
# "development" or "production". In production the app refuses to boot with the
# default SECRET_KEY, and enables TrustedHostMiddleware.
ENVIRONMENT=development

# Signing key for JWTs. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production. No default is used there.
SECRET_KEY=change-me-to-a-long-random-string

# How long an access token stays valid, in minutes. 7 days by default.
ACCESS_TOKEN_MINUTES=10080

# --- database ---------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./bayaan.db
#
# Postgres (what docker-compose uses):
# DATABASE_URL=postgresql+psycopg://bayaan:bayaan@db:5432/bayaan
#
# Vercel / any read-only filesystem — SQLite must live in /tmp:
# DATABASE_URL=sqlite:////tmp/bayaan.db

# --- local backend: Ollama --------------------------------------------------
# Leave blank to disable. When set, "local" runs go to this server.
#   ollama serve && ollama pull llama3.1:8b
OLLAMA_BASE_URL=
# How long to wait for a local generation, in seconds. Local models are slow on
# CPU — 120s is not generous.
OLLAMA_TIMEOUT_SECONDS=120

# --- cloud backend: any OpenAI-compatible API -------------------------------
# Together, Groq, Fireworks, vLLM, LM Studio, OpenRouter — they all speak this
# shape. Leave blank to disable.
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_TIMEOUT_SECONDS=90

# Maps a catalog model id to the provider's model name. JSON, one line.
# Example for Together:
# CLOUD_MODEL_MAP={"llama-3.1-8b-instruct":"meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo","mistral-7b-instruct":"mistralai/Mistral-7B-Instruct-v0.3"}
CLOUD_MODEL_MAP={}

# --- limits -----------------------------------------------------------------
# Per-IP, per-route. Format: "<count>/<minute|hour|second>".
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_RUNS=30/minute

# Longest user prompt accepted, in characters. Guards against someone pasting a
# 40MB log file into a textarea.
MAX_PROMPT_CHARS=20000

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser. The SPA is
# served from the same origin, so this is only needed for external clients.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- deployment -------------------------------------------------------------
# Set to 1 on Vercel. Switches the app to serverless-safe behaviour (no lifespan
# reliance, /tmp database).
VERCEL=0

# Hostnames TrustedHostMiddleware will accept in production. Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1
